{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    "games": {
      ".write": true,
      ".read": true,
      "$uid": {
        "owner": { ".validate": "newData.isString()" },
        "opponent": { ".validate": "newData.isString()" },
        "moves": {
          "$moveid": {
            "position": { ".validate": "newData.isNumber()" },
            "uid": { ".validate": "newData.isString()" }
          }
        }
      }
    },
    "matchmaking": {
      ".write": true
    },
    "pincodes": {
      "$shortid": {
        ".read": true,
        ".validate": "newData.isString()",

        // Dynamically picks newData (creation) or data (deletion) to do a single owner check
        ".write": true
      }
    },
    "users": {
      ".write": true,
      ".read": true
    }
  }
}
