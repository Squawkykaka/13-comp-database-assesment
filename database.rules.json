{
  /* Visit https://firebase.google.com/docs/database/security to learn more about security rules. */
  "rules": {
    "games": {
      "$uid": {
        ".read": true,
        ".write": "!data.exists()",
        "owner": {
          ".validate": "newData.isString()",
          ".write": "!data.exists() && newData.val() === auth.uid"
        },
        "opponent": {
          ".validate": "newData.isString()",
          ".write": "!data.exists() && newData.val() === auth.uid"
        },
        "moves": {
          ".write": "data.parent().child('owner').val() === auth.uid || data.parent().child('opponent').val() === auth.uid",
          "$moveid": {
            "position": { ".validate": "newData.isNumber()" },
            "uid": { ".validate": "newData.isString()" }
          }
        }
      }
    },
    "pincodes": {
      "$shortid": {
        ".read": true,
        ".write": true,
        ".validate": "newData.isString()"
      }
    },
    "users": {
      ".indexOn": ["wins", "losses"],
      ".read": true,
      "$uid": {
        ".write": "auth.uid === $uid"
      }
    },
    "private": {
      "$uid": {
        ".read": "auth.uid === $uid",
        ".write": "auth.uid === $uid"
      }
    }
  }
}
